<header class="flex justify-between items-center p-4 bg-gray-100 shadow-md">
  <h1 class="text-xl font-semibold">Dashboard</h1>
  <%= button_to 'Logout', destroy_user_session_path, method: :delete, class: 'bg-red-500 text-white px-4 py-2 rounded-lg' %>
</header>

<p class="text-green-600 text-center"><%= notice %></p>

<!-- Título centralizado e maior -->
<h1 class="text-5xl font-semibold text-center text-blue-600 mt-10">
  Equipes
</h1>

<!-- Grid de unidades com espaçamento nas laterais -->
<div id="units" class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 px-4">
  <% @teams.each do |team| %>
    <!-- Card para cada unidade com largura maior e centralizado -->
    <div class="w-full max-w-md mx-auto bg-gray-100 border border-slate-200 rounded-xl shadow-md p-6">
      <!-- Nome da unidade centralizado -->
      <h2 class="text-2xl font-semibold text-blue-600 text-center mb-6">
        <%= team.name %>
      </h2>

      <!-- Nome da unidade associada à equipe (cor de fonte cinza clarinho) -->
      <p class="text-center text-lg text-gray-400 mb-4">
      <strong>Unidade:</strong> <%= team.unit.name %>
      </p>

      <!-- Botões centralizados -->
      <div class="flex justify-center space-x-4">
        <%= link_to "Visualizar", team_path(team), class: "bg-blue-500 text-white text-lg px-6 py-2 rounded-lg hover:bg-blue-700 transition" %>
        <%= link_to "Editar", edit_team_path(team), class: "bg-green-500 text-white text-lg px-6 py-2 rounded-lg hover:bg-green-700 transition" %>
      </div>
    </div>
  <% end %>
</div>

<!-- Botão "Voltar" e "Nova Equipe" ao lado -->
<div class="mt-8 flex justify-center space-x-4">
  <%= link_to "Nova Equipe", new_team_path, class: "bg-blue-500 text-white text-lg px-8 py-4 rounded-lg hover:bg-blue-700 transition" %>
  <%= link_to "Voltar", root_path,
    class: "bg-gray-500 text-white text-lg px-8 py-4 rounded-lg hover:bg-gray-700 transition" %>
</div>