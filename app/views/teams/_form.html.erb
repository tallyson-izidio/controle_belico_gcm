<%= form_with(model: team, local: true) do |form| %>
  <% if team.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(team.errors.count, "erro") %> impediram o salvamento:</h2>
      <ul>
        <% team.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, "Nome da Equipe" %><br>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :unit_id, "Unidade" %><br>
    <%= form.collection_select :unit_id, Unit.all, :id, :name, prompt: "Selecione uma unidade" %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>