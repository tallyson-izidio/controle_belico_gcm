<header class="flex justify-between items-center p-4 bg-gray-100 shadow-md">
  <h1 class="text-xl font-semibold">Dashboard</h1>
  <%= button_to 'Logout', destroy_user_session_path, method: :delete, class: 'bg-red-500 text-white px-4 py-2 rounded-lg' %>
</header>

<h1 class="text-4xl font-semibold text-center text-blue-600 mt-10">
  Editar Arma
</h1>

<!-- Card para o formulário de edição -->
<div class="w-full max-w-md mx-auto bg-gray-100 border border-slate-200 rounded-xl shadow-lg p-6 mt-8">
  <%= form_with(model: @weapon, local: true) do |form| %>
    <% if @weapon.errors.any? %>
      <div id="error_explanation" class="mb-4">
        <h2 class="text-red-500"><%= pluralize(@weapon.errors.count, "erro") %> impediram o salvamento:</h2>
        <ul>
          <% @weapon.errors.full_messages.each do |msg| %>
            <li class="text-red-500"><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- Campo de nome da arma -->
    <div class="field mb-4">
      <%= form.label :model, "Modelo da Arma", class: "block text-lg text-blue-600 mb-2" %>
    <%= form.text_field :model, class: "bg-white text-lg text-gray-700 placeholder:text-slate-400 placeholder:opacity-75 w-full p-3 focus:outline-none focus:border-blue-500", placeholder: "Digite o modelo da arma" %>
    </div>

    <div class="field mb-4">
      <%= form.label :registration, "Registro da Arma", class: "block text-lg text-blue-600 mb-2" %>
      <%= form.text_field :registration, class: "bg-white text-lg text-gray-700 placeholder:text-slate-400 placeholder:opacity-75 w-full p-3 focus:outline-none focus:border-blue-500", placeholder: "Digite o registro da arma" %>
    </div>

    <div class="field mb-4">
     <%= form.label :borrowed, "Emprestada?", class: "block text-lg text-blue-600 mb-2" %>
     <%= form.check_box :borrowed, class: "text-xl" %>
    </div>


    <!-- Botão de submit -->
    <div class="actions mt-4">
      <%= form.submit "Atualizar Arma", class: "w-full bg-blue-500 text-white text-lg px-6 py-2 rounded-lg hover:bg-blue-700 transition" %>
    </div>
  <% end %>
</div>

<!-- Botão "Voltar" -->
<div class="mt-8 flex justify-center">
  <%= link_to "Voltar", weapons_path, class: "bg-gray-500 text-white text-lg px-8 py-4 rounded-lg hover:bg-gray-700 transition" %>
</div>
