<header class="flex justify-between items-center p-4 bg-gray-100 shadow-md">
  <h1 class="text-xl font-semibold">Dashboard</h1>
  <%= button_to 'Logout', destroy_user_session_path, method: :delete, class: 'bg-red-500 text-white px-4 py-2 rounded-lg' %>
</header>

<h1 class="text-4xl font-semibold text-center text-blue-600 mt-10">
  Cadastro de Usuário
</h1>

<!-- Card para o formulário de criação de usuário -->
<div class="w-full max-w-md mx-auto bg-gray-100 border border-slate-200 rounded-xl shadow-lg p-6 mt-8">
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
    
    <!-- Exibindo erros -->
    <%= render "devise/shared/error_messages", resource: resource %>

    <!-- Nome completo -->
    <div class="mb-4">
      <%= f.label :name, "Nome completo", class: "block text-lg text-blue-600" %>
      <%= f.text_field :name, autofocus: true, class: "bg-white text-lg text-gray-700 placeholder:text-slate-400 placeholder:opacity-75 border border-slate-300 rounded-lg w-full p-3 focus:outline-none focus:border-blue-500", placeholder: "Digite seu nome completo" %>
    </div>

    <!-- E-mail -->
    <div class="mb-4">
      <%= f.label :email, "E-mail", class: "block text-lg text-blue-600" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "bg-white text-lg text-gray-700 placeholder:text-slate-400 placeholder:opacity-75 border border-slate-300 rounded-lg w-full p-3 focus:outline-none focus:border-blue-500", placeholder: "Digite seu e-mail" %>
    </div>

    <!-- Senha -->
    <div class="mb-4">
      <%= f.label :password, "Senha", class: "block text-lg text-blue-600" %>
      <% if @minimum_password_length %>
        <em class="text-sm text-gray-500">(<%= @minimum_password_length %> caracteres no mínimo)</em>
      <% end %>
      <%= f.password_field :password, autocomplete: "new-password", class: "bg-white text-lg text-gray-700 placeholder:text-slate-400 placeholder:opacity-75 border border-slate-300 rounded-lg w-full p-3 focus:outline-none focus:border-blue-500", placeholder: "Digite sua senha" %>
    </div>

    <!-- Confirmação de Senha -->
    <div class="mb-4">
      <%= f.label :password_confirmation, "Confirme a senha", class: "block text-lg text-blue-600" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "bg-white text-lg text-gray-700 placeholder:text-slate-400 placeholder:opacity-75 border border-slate-300 rounded-lg w-full p-3 focus:outline-none focus:border-blue-500", placeholder: "Confirme sua senha" %>
    </div>

    <!-- Botão de envio -->
    <div class="actions mt-6">
      <%= f.submit "Cadastrar", class: "w-full bg-blue-500 text-white text-lg px-6 py-4 rounded-lg hover:bg-blue-700 transition" %>
    </div>
  <% end %>
</div>

<!-- Links adicionais -->
<%= render "devise/shared/links" %>