<header class="flex justify-between items-center p-4 bg-gray-100 shadow-md">
  <h1 class="text-xl font-semibold">Dashboard</h1>
  <%= button_to 'Logout', destroy_user_session_path, method: :delete, class: 'bg-red-500 text-white px-4 py-2 rounded-lg' %>
</header>

<p class="text-green-600 text-center"><%= notice %></p>

<!-- Título centralizado e maior -->
<h1 class="text-4xl font-semibold text-center text-blue-600 mt-10">
  Editar Guarda
</h1>

<!-- Card para o formulário de edição -->
<div class="w-full max-w-md mx-auto bg-gray-100 border border-slate-200 rounded-xl shadow-lg p-6 mt-8">
  <%= form_with(model: @guard, local: true) do |form| %>
    <% if @guard.errors.any? %>
      <div id="error_explanation" class="mb-4">
        <h2 class="text-red-500">
          <%= pluralize(@guard.errors.count, "erro") %> impediram o salvamento:
        </h2>
        <ul>
          <% @guard.errors.full_messages.each do |msg| %>
            <li class="text-red-500"><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- Campo de nome completo do guarda -->
    <div class="field mb-4">
      <%= form.label :full_name, "Nome Completo", class: "block text-lg text-blue-600 mb-2" %>
      <%= form.text_field :full_name, class: "bg-white text-lg text-gray-700 placeholder:text-slate-400 placeholder:opacity-75 border border-slate-300 rounded-lg w-full p-3 focus:outline-none focus:border-blue-500", placeholder: "Edite aqui" %>
    </div>

    <!-- Campo de matrícula -->
    <div class="field mb-4">
      <%= form.label :matricula, "Matrícula", class: "block text-lg text-blue-600 mb-2" %>
      <%= form.text_field :matricula, class: "bg-white text-lg text-gray-700 placeholder:text-slate-400 placeholder:opacity-75 border border-slate-300 rounded-lg w-full p-3 focus:outline-none focus:border-blue-500", placeholder: "Edite aqui" %>
    </div>

    <!-- Campo de número do porte -->
    <div class="field mb-4">
      <%= form.label :porte_numero, "Porte nº", class: "block text-lg text-blue-600 mb-2" %>
      <%= form.text_field :porte_numero, class: "bg-white text-lg text-gray-700 placeholder:text-slate-400 placeholder:opacity-75 border border-slate-300 rounded-lg w-full p-3 focus:outline-none focus:border-blue-500", placeholder: "Edite aqui" %>
    </div>

    <!-- Campo de unidade -->
    <div class="field mb-6">
      <%= form.label :team_id, "Equipe", class: "block text-lg text-blue-600 mb-2" %>
      <%= form.collection_select :team_id, Team.all, :id, :name,
            { prompt: "Selecione a equipe" },
            class: "bg-white text-lg text-gray-700 border border-slate-300 rounded-lg w-full p-3 focus:outline-none focus:border-blue-500" %>
    </div>

    <!-- Botão de submit -->
    <div class="actions mt-4">
      <%= form.submit "Atualizar Guarda", class: "w-full bg-blue-500 text-white text-lg px-6 py-2 rounded-lg hover:bg-blue-700 transition" %>
    </div>
  <% end %>
</div>

<!-- Botão "Voltar" -->
<div class="mt-8 mb-10 flex justify-center">
  <%= link_to "Voltar", guards_path, class: "bg-gray-500 text-white text-lg px-8 py-4 rounded-lg hover:bg-gray-700 transition" %>
</div>
