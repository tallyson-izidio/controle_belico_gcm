<div id="<%= dom_id movement %>">
  <p>
    <strong>Armeiro:</strong>
    <%= movement.armeiro_id %>
  </p>

  <p>
    <strong>Guard:</strong>
    <%= movement.guard_id %>
  </p>

  <p>
    <strong>Weapon:</strong>
    <%= movement.weapon_id %>
  </p>

  <p>
    <strong>Movement type:</strong>
    <%= movement.movement_type %>
  </p>

  <p>
    <strong>Date:</strong>
    <%= movement.date %>
  </p>

  <p>
    <strong>Time:</strong>
    <%= movement.time %>
  </p>

  <p>
    <strong>Ammo count:</strong>
    <%= movement.ammo_count %>
  </p>

  <p>
    <strong>Ammo caliber:</strong>
    <%= movement.ammo_caliber %>
  </p>

  <p>
    <strong>Magazine count:</strong>
    <%= movement.magazine_count %>
  </p>

  <p>
    <strong>Justification:</strong>
    <%= movement.justification %>
  </p>

</div>