<h1 class="text-4xl font-semibold text-center text-blue-600 mt-10">
  Nova Movimentação
</h1>

<!-- Card para o formulário de criação -->
<div class="w-full max-w-md mx-auto bg-gray-100 border border-slate-200 rounded-xl shadow-lg p-6 mt-8">
  <%= form_with(model: @movement, url: movements_path, method: :post, local: true, data: { turbo: false }) do |f| %>
    <% if @movement.errors.any? %>
      <div id="error_explanation" class="mb-4">
        <h2 class="text-red-500">
          <%= pluralize(@movement.errors.count, "erro") %> impediram o salvamento:
        </h2>
        <ul>
          <% @movement.errors.full_messages.each do |msg| %>
            <li class="text-red-500"><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- Tipo -->
    <div class="mb-4">
      <%= f.label :movement_type, "Tipo", class: "block text-lg text-blue-600 mb-2" %>
      <%= f.select :movement_type,
                   Movement.movement_types.keys.map { |t| [t.humanize, t] },
                   { prompt: "Selecione o tipo" },
                   class: "w-full p-3 border rounded" %>
    </div>

    <!-- Armeiro -->
    <div class="mb-4">
      <%= f.label :armeiro_id, "Armeiro", class: "block text-lg text-blue-600 mb-2" %>
      <%= f.collection_select :armeiro_id, Guard.all, :id, :full_name,
                              { prompt: "Selecione o armeiro" },
                              class: "w-full p-3 border rounded" %>
    </div>

    <!-- Guarda -->
    <div class="mb-4">
      <%= f.label :guard_id, "Guarda", class: "block text-lg text-blue-600 mb-2" %>
      <%= f.collection_select :guard_id, Guard.all, :id, :full_name,
                              { prompt: "Selecione o guarda" },
                              class: "w-full p-3 border rounded" %>
    </div>

    <!-- Arma -->
    <div class="mb-4">
      <%= f.label :weapon_id, "Arma", class: "block text-lg text-blue-600 mb-2" %>
      <%= f.collection_select :weapon_id, Weapon.all, :id, :model,
                              { prompt: "Selecione a arma" },
                              class: "w-full p-3 border rounded" %>
    </div>

    <!-- Data -->
    <div class="mb-4">
      <%= f.label :date, "Data", class: "block text-lg text-blue-600 mb-2" %>
      <%= f.date_field :date, class: "w-full p-3 border rounded" %>
    </div>

    <!-- Hora -->
    <div class="mb-4">
      <%= f.label :time, "Hora", class: "block text-lg text-blue-600 mb-2" %>
      <%= f.time_field :time, class: "w-full p-3 border rounded" %>
    </div>

    <!-- Balas -->
    <div class="mb-4">
      <%= f.label :ammo_count, "Quantidade de Balas", class: "block text-lg text-blue-600 mb-2" %>
      <%= f.number_field :ammo_count, class: "w-full p-3 border rounded" %>
    </div>

    <!-- Calibre -->
    <div class="mb-4">
      <%= f.label :ammo_caliber, "Calibre", class: "block text-lg text-blue-600 mb-2" %>
      <%= f.text_field :ammo_caliber, class: "w-full p-3 border rounded", placeholder: "Digite o calibre" %>
    </div>

    <!-- Carregadores -->
    <div class="mb-4">
      <%= f.label :magazine_count, "Quantidade de Carregadores", class: "block text-lg text-blue-600 mb-2" %>
      <%= f.number_field :magazine_count, class: "w-full p-3 border rounded" %>
    </div>

    <!-- Justificativa -->
    <div class="mb-4">
      <%= f.label :justification, "Justificativa (se aplicável)", class: "block text-lg text-blue-600 mb-2" %>
      <%= f.text_area :justification, class: "w-full p-3 border rounded", placeholder: "Explique se houve falta" %>
    </div>

    <!-- Botão -->
    <div class="mt-6">
      <%= f.submit "Registrar Movimentação", class: "w-full bg-blue-500 text-white py-3 rounded hover:bg-blue-700" %>
    </div>
  <% end %>
</div>

<!-- Botão de Voltar -->
<div class="mt-8 flex justify-center">
  <%= link_to "Voltar", movements_path, class: "bg-gray-500 text-white text-lg px-8 py-4 rounded-lg hover:bg-gray-700 transition" %>
</div>
