<header class="flex justify-between items-center p-4 bg-gray-100 shadow-md">
  <h1 class="text-xl font-semibold">Dashboard</h1>
  <%= button_to 'Logout', destroy_user_session_path, method: :delete, class: 'bg-red-500 text-white px-4 py-2 rounded-lg' %>
</header>

<h1 class="text-4xl font-semibold text-center text-blue-600 mt-10">
  Editar Movimentação
</h1>

<!-- Card para o formulário de edição -->
<div class="w-full max-w-md mx-auto bg-gray-100 border border-slate-200 rounded-xl shadow-lg p-6 mt-8">
  <%= form_with(model: @movement, local: true) do |form| %>
    <% if @movement.errors.any? %>
      <div id="error_explanation" class="mb-4">
        <h2 class="text-red-500"><%= pluralize(@movement.errors.count, "erro") %> impediram o salvamento:</h2>
        <ul>
          <% @movement.errors.full_messages.each do |msg| %>
            <li class="text-red-500"><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- Tipo da Movimentação -->
    <div class="mb-4">
      <%= form.label :movement_type, "Tipo", class: "block text-lg text-blue-600 mb-2" %>
      <%= form.select :movement_type, Movement.movement_types.keys.map { |t| [t.humanize, t] }, { prompt: "Selecione o tipo" }, class: "w-full p-3 border rounded" %>
    </div>

    <!-- Armeiro -->
    <div class="mb-4">
      <%= form.label :armeiro_id, "Armeiro", class: "block text-lg text-blue-600 mb-2" %>
      <%= form.collection_select :armeiro_id, Guard.all, :id, :full_name, { prompt: "Selecione o armeiro" }, class: "w-full p-3 border rounded" %>
    </div>

    <!-- Guarda -->
    <div class="mb-4">
      <%= form.label :guard_id, "Guarda", class: "block text-lg text-blue-600 mb-2" %>
      <%= form.collection_select :guard_id, Guard.all, :id, :full_name, { prompt: "Selecione o guarda" }, class: "w-full p-3 border rounded" %>
    </div>

    <!-- Arma -->
    <div class="mb-4">
      <%= form.label :weapon_id, "Arma", class: "block text-lg text-blue-600 mb-2" %>
      <%= form.collection_select :weapon_id, Weapon.all, :id, :model, { prompt: "Selecione a arma" }, class: "w-full p-3 border rounded" %>
    </div>

    <!-- Data -->
    <div class="mb-4">
      <%= form.label :date, "Data", class: "block text-lg text-blue-600 mb-2" %>
      <%= form.date_field :date, class: "w-full p-3 border rounded" %>
    </div>

    <!-- Hora -->
    <div class="mb-4">
      <%= form.label :time, "Hora", class: "block text-lg text-blue-600 mb-2" %>
      <%= form.time_field :time, class: "w-full p-3 border rounded" %>
    </div>

    <!-- Quantidade de Balas -->
    <div class="mb-4">
      <%= form.label :ammo_count, "Quantidade de Balas", class: "block text-lg text-blue-600 mb-2" %>
      <%= form.number_field :ammo_count, class: "w-full p-3 border rounded" %>
    </div>

    <!-- Calibre -->
    <div class="mb-4">
      <%= form.label :ammo_caliber, "Calibre", class: "block text-lg text-blue-600 mb-2" %>
      <%= form.text_field :ammo_caliber, class: "w-full p-3 border rounded", placeholder: "Digite o calibre" %>
    </div>

    <!-- Quantidade de Carregadores -->
    <div class="mb-4">
      <%= form.label :magazine_count, "Quantidade de Carregadores", class: "block text-lg text-blue-600 mb-2" %>
      <%= form.number_field :magazine_count, class: "w-full p-3 border rounded" %>
    </div>

    <!-- Justificativa -->
    <div class="mb-4">
      <%= form.label :justification, "Justificativa (se aplicável)", class: "block text-lg text-blue-600 mb-2" %>
      <%= form.text_area :justification, class: "w-full p-3 border rounded", placeholder: "Explique se houve falta" %>
    </div>

    <!-- Botão de Submit -->
    <div class="mt-6">
      <%= form.submit "Atualizar Movimentação", class: "w-full bg-blue-500 text-white py-3 rounded hover:bg-blue-700" %>
    </div>
  <% end %>
</div>

<!-- Botão de Voltar -->
<div class="mt-8 flex justify-center">
  <%= link_to "Voltar", movement_path(@movement), class: "bg-gray-500 text-white text-lg px-8 py-4 rounded-lg hover:bg-gray-700 transition" %>
</div>
