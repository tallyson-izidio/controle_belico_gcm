<%= form_with(model: movement, local: true) do |form| %>
  <% if movement.errors.any? %>
    <div id="error_explanation" class="mb-4">
      <h2 class="text-red-500"><%= pluralize(movement.errors.count, "erro") %> impediram o salvamento:</h2>
      <ul>
        <% movement.errors.full_messages.each do |msg| %>
          <li class="text-red-500"><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-4">
    <%= form.label :movement_type, "Tipo" %><br>
    <%= form.select :movement_type, Movement.movement_types.keys.map { |t| [t.humanize, t] }, prompt: "Selecione o tipo" %>
  </div>

  <div class="mb-4">
    <%= form.label :armeiro_id, "Armeiro" %><br>
    <%= form.collection_select :armeiro_id, Guard.all, :id, :full_name, prompt: "Selecione o armeiro" %>
  </div>

  <div class="mb-4">
    <%= form.label :guard_id, "Guarda" %><br>
    <%= form.collection_select :guard_id, Guard.all, :id, :full_name, prompt: "Selecione o guarda" %>
  </div>

  <div class="mb-4">
    <%= form.label :weapon_id, "Arma" %><br>
    <%= form.collection_select :weapon_id, Weapon.all, :id, :model, prompt: "Selecione a arma" %>
  </div>

  <div class="mb-4">
    <%= form.label :date, "Data" %><br>
    <%= form.date_field :date %>
  </div>

  <div class="mb-4">
    <%= form.label :time, "Hora" %><br>
    <%= form.time_field :time %>
  </div>

  <div class="mb-4">
    <%= form.label :ammo_count, "Quantidade de Balas" %><br>
    <%= form.number_field :ammo_count %>
  </div>

  <div class="mb-4">
    <%= form.label :ammo_caliber, "Calibre" %><br>
    <%= form.text_field :ammo_caliber %>
  </div>

  <div class="mb-4">
    <%= form.label :magazine_count, "Quantidade de Carregadores" %><br>
    <%= form.number_field :magazine_count %>
  </div>

  <div class="mb-4">
    <%= form.label :justification, "Justificativa (se aplicável)" %><br>
    <%= form.text_area :justification %>
  </div>

  <div>
    <%= form.submit "Registrar Movimentação", class: "w-full bg-blue-500 text-white text-lg px-6 py-4 rounded-lg hover:bg-blue-700 transition" %>
  </div>
<% end %>
